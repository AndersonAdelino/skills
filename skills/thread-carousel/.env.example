# Copie para .env e preencha só o que for usar. Nenhuma das duas é obrigatória:
# sem chave nenhuma o carrossel sai com as suas imagens, com as que a skill
# baixou da web, ou só com texto.
#
# Grave este arquivo em UTF-8 sem BOM. O script lê como utf-8-sig justamente
# porque o Bloco de Notas e `Out-File -Encoding utf8` gravam BOM no Windows, e
# aí a primeira chave do arquivo nunca casa com o nome.

# Gerar imagem por IA — https://kie.ai  (custa crédito por imagem)
KIE_API_KEY=

# Banco de imagens com licença livre — https://www.pexels.com/api/  (grátis)
PEXELS_API_KEY=
