# Copie para .env na raiz do projeto do site. Nunca commite o .env.
# Token: cPanel → Segurança → Gerenciar tokens de API (o valor aparece uma vez).
#
# Grave em UTF-8 SEM BOM. O script lê como utf-8-sig de propósito, porque o
# Bloco de Notas e `Out-File -Encoding utf8` gravam BOM no Windows — sem isso a
# primeira chave do arquivo nunca casaria com o nome.

CPANEL_HOST=seudominio.com.br
CPANEL_USER=usuario_cpanel
CPANEL_TOKEN=
CPANEL_PORT=2083
DEPLOY_PATH=public_html
SOURCE_DIR=dist

# Endereço público do site, usado para conferir no fim se a home nova subiu.
# Vazio = usa https://CPANEL_HOST, que erra quando o site é um addon domain.
SITE_URL=
