# ── .env da RAIZ DO PROJETO: a conta de hospedagem ──────────────────────────
#
# Preencha uma vez. Serve para todos os clientes.
# Token: cPanel -> Segurança -> Gerenciar tokens de API (o valor aparece uma
# vez, e precisa de permissão de File Manager).
#
# Grave em UTF-8 SEM BOM. O script lê como utf-8-sig de propósito, porque o
# Bloco de Notas e `Out-File -Encoding utf8` gravam BOM no Windows.

CPANEL_HOST=seudominio.com.br
CPANEL_USER=usuario_cpanel
CPANEL_TOKEN=
CPANEL_PORT=2083

# ── .env DE CADA CLIENTE (clientes/<nome>/.env): só o destino ───────────────
#
# O script sobe até 4 pastas juntando os .env, e o mais próximo ganha. Então
# o cliente não precisa de uma cópia do token.
#
#   DEPLOY_PATH=public_html/nome-do-cliente
#   SITE_URL=https://seudominio.com.br/nome-do-cliente
#
# Uma pasta por cliente: dois apontando para public_html e o segundo deploy
# sobrescreve o primeiro sem avisar.

DEPLOY_PATH=public_html
SOURCE_DIR=dist
SITE_URL=
