# Secrets — never commit. remove-fillers.py walks up the folder tree looking for a
# .env, so a .env dropped at any level of this repo would land in git without this.
.env
.env.*
!.env.example
*.key
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Mídia de teste — o repo guarda skills, não vídeo
*.mp4
*.mov
*.mkv
*.mp3
*.wav
*.fillers.json
editado/
_tmp/

# Sistema
.DS_Store
Thumbs.db
