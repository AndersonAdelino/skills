# Secrets — never commit. remove-fillers.py walks up the folder tree looking for a
# .env, so a .env dropped at any level of this repo would land in git without this.
.env
.env.*
!.env.example
*.key
credentials.json
token.json

# Local dev loop: .claude/skills/<name> is a junction back into skills/<name>,
# so Claude Code loads the working copy live while developing in this repo.
# Git would follow the junction and commit every file twice.
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Mídia de teste — o repo guarda skills, não vídeo
*.mp4
*.mov
*.mkv
*.mp3
*.wav
*.fillers.json
editado/
_tmp/

# Sistema
.DS_Store
Thumbs.db

# trabalho de cliente: CNPJ, telefone e endereco nao entram no repo publico
clientes/

# saida da thread-carousel: foto de perfil, @ do dono da conta e PNG de post
# pronto. E conteudo pessoal e pesado, o repo guarda a skill e nao o que ela
# produziu. O config.json fica aqui porque o script procura ao lado do spec e
# sobe ate 3 pastas, entao a raiz dos carrosseis e o lugar certo dele.
carrosseis/
